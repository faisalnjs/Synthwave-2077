{
	"name": "synthwave-2077-neon-glow",
	"displayName": "Synthwave 2077 Neon Glow",
	"description": "Synthwave 2077 x Neon",
	"version": "1.0.0",
	"icon": "icon.png",
	"author": "Faisal N, CodeSasha, Robb Owen, et. al.",
	"publisher": "DangoWeb",
	"license": "GNU General Public License v3.0",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"synthwave",
		"cyberpunk",
		"retrowave",
		"outrun",
		"neon",
		"vaporwave",
		"dark",
		"theme",
		"color",
		"syntax",
		"highlight",
		"editor",
		"code",
		"vscode",
		"visual",
		"studio",
		"text",
		"editor",
		"extension",
		"extensionpack",
		"extension-pack",
		"extensionpacks"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/faisalnjs/Synthwave-2077.git",
		"directory": "neon-glow"
	},
	"contributes": {
		"commands": [
			{
				"command": "synthwave2077.toggleGlow",
				"title": "Toggle Neon Glow",
				"category": "Synthwave 2077"
			}
		],
		"configuration": {
			"title": "Synthwave 2077 Neon Glow",
			"properties": {
				"synthwave2077.glow.enabled": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"description": "Enable the optional text glow while Synthwave 2077 is active."
				},
				"synthwave2077.glow.brightness": {
					"type": "number",
					"default": 0.45,
					"minimum": 0,
					"maximum": 1,
					"scope": "application",
					"description": "Opacity of the text glow, from 0 (invisible) to 1 (full strength)."
				}
			}
		}
	},
	"galleryBanner": {
		"color": "#101116",
		"theme": "dark"
	},
	"bugs": {
		"url": "https://github.com/faisalnjs/Synthwave-2077/issues",
		"email": "contact@faisaln.com"
	},
	"extensionDependencies": [
		"DangoWeb.synthwave-2077"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	}
}
